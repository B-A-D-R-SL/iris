# Optional local overrides. Copy to .env only if you need to customize defaults.
# AI contribution: 50% or more AI-generated
# Never use these local development credentials in production.
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris_local_dev_password
DJANGO_SECRET_KEY=iris-insecure-local-dev-key-change-before-deploying
DJANGO_DEV_ADMIN_EMAIL=admin@iris.local
DJANGO_DEV_ADMIN_PASSWORD=iris_local_admin_password

# Host-only ports; containers use 5432/8000/5173/10000/8025/1025 internally.
IRIS_DB_PORT=55433
IRIS_BACKEND_PORT=8000
IRIS_FRONTEND_PORT=5174
IRIS_AZURITE_PORT=10000
IRIS_MAILPIT_UI_PORT=8025
IRIS_SMTP_PORT=1025
