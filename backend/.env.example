# AI contribution: 50% or more AI-generated
DJANGO_SECRET_KEY=CHANGE_ME_LOCAL_ONLY

# Required when running Django outside Compose. Compose uses db:5432 internally.
# Start Docker Compose to expose PostgreSQL on localhost:55433.
DATABASE_URL=postgresql://iris:iris_local_dev_password@127.0.0.1:55433/iris

# WSGI connection lifetime in seconds; 0 closes after every request.
# Settings always use 0 for local runserver and the ASGI entry point.
DATABASE_CONN_MAX_AGE=60

# Maximum wait for each duplicate-check advisory lock, in milliseconds.
HOUSEHOLD_DUPLICATE_LOCK_TIMEOUT_MS=5000

# Azure / Azurite
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_CONNECTION_STRING=
# Internal API endpoint; omit when the connection string supplies BlobEndpoint.
AZURE_STORAGE_BLOB_ENDPOINT=
# Browser-reachable endpoint. Locally: http://localhost:10000/devstoreaccount1
AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=
# Permit HTTP only for localhost/loopback or the Docker service named azurite.
# Keep False in staging/production; use HTTPS and credentials from Key Vault.
AZURE_STORAGE_ALLOW_HTTP=False
LISTING_PHOTO_STORE_BACKEND=modules.listings.photo_storage.configured_store
LISTING_PHOTO_MAX_PIXELS=20000000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# Production hosts, comma-separated
DJANGO_ALLOWED_HOSTS=

# Production uses a generated secret of at least 50 characters; the local
# placeholders and django-insecure/iris-insecure prefixes are refused.
# Production refuses console, dummy, filebased and locmem EMAIL_BACKEND values.
# Set EMAIL_BACKEND to a real delivery backend.
# See docs/guides/production-settings.md before deploying behind a proxy.

# Production DRF request limits; the partner form retains its separate 5/hour/IP.
DRF_ANON_THROTTLE_RATE=60/min
DRF_USER_THROTTLE_RATE=300/min
# 0 ignores forwarded client IPs. Set the verified trusted proxy count in Azure.
DRF_NUM_PROXIES=0
