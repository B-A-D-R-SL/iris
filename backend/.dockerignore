# AI contribution: 50% or more AI-generated
# Keep credentials out of every package directory in the build context.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/.aws/
**/.azure/
**/.ssh/
**/.gnupg/
**/credentials
**/credentials.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore

# Dependencies, bytecode and local test/build outputs are recreated in the image.
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/coverage/
**/coverage.xml
**/*.egg-info/
**/*.egg
**/node_modules/
**/build/
**/dist/

# Includes generated photo-demo images under backend/tmp.
**/tmp/
**/temp/
**/*.tmp
**/*.bak
**/*.log
**/logs/
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*

**/.git
**/.hg/
**/.svn/
**/.idea/
**/.vscode/
**/*.iml
**/*.swp
**/.DS_Store
**/Thumbs.db
**/desktop.ini
